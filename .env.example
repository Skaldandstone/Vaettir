# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaettir?schema=public"

# AI agent (reverse-engineering + strategy generation)
ANTHROPIC_API_KEY=""

# API
API_PORT=4000

# Auth (Clerk) - api verifies session tokens with the secret key; web/mobile
# use the publishable key to initialize the Clerk client.
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:4000"

# GitHub App / PR scanning (phase 2)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Observability (P10-05) - Sentry error tracking. Inert (no code changes
# needed) if left unset - api/web both boot and run identically without
# it. NEXT_PUBLIC_SENTRY_DSN is usually the same DSN as SENTRY_DSN, just
# exposed to the browser bundle (Sentry DSNs are meant to be public).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DEBUG=1 logs every Sentry SDK operation to stdout - useful for
# confirming an error was actually captured, noisy otherwise.
SENTRY_DEBUG=""

# Stripe: disabled by default. `live` is unsupported. Keep the free beta here.
# `test` is loopback-only. `hosted-test` is a private AWS development sandbox
# validation path with a protected catalog and synthetic database; it is not a
# paid launch. See docs/private-beta/billing-integration.md before configuring.
VAETTIR_BILLING_MODE="disabled"
VAETTIR_STRIPE_ENVIRONMENT=""
VAETTIR_STRIPE_SANDBOX=""
VAETTIR_STRIPE_ACCOUNT_ID=""
VAETTIR_BILLING_RETURN_ORIGIN="http://localhost:3000"
VAETTIR_STRIPE_OFFERS_JSON="[]"
VAETTIR_STRIPE_PORTAL_CONFIGURATION=""
# Hosted-test deliberate gate and exact deployment identity. Leave blank.
VAETTIR_BILLING_HOSTED_TEST_GATE=""
VAETTIR_DEPLOYMENT_ENVIRONMENT=""
VAETTIR_AWS_ACCOUNT_ID=""
VAETTIR_BILLING_APPROVED_ORIGIN=""
# Absolute files inside one protected/vault mount, never secret values.
VAETTIR_BILLING_MOUNT_DIR=""
VAETTIR_STRIPE_CATALOG_FILE=""
VAETTIR_STRIPE_KEY_FILE=""
VAETTIR_STRIPE_WEBHOOK_SECRET_FILE=""
