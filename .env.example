# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaettir?schema=public"

# AI agent (reverse-engineering + strategy generation)
ANTHROPIC_API_KEY=""

# API
API_PORT=4000

# Auth (Clerk) - api verifies session tokens with the secret key; web/mobile
# use the publishable key to initialize the Clerk client.
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:4000"

# GitHub App / PR scanning (phase 2)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Staff-only admin > Repo Health Snapshot (admin.repoHealthSnapshot) - a
# plain PAT with `repo` + `actions:read` scope, used to read GitHub Actions
# run history for ANY repo pointed at it, not just onboarded customers'.
# Not used anywhere else; leave unset if that tool isn't needed.
STAFF_GITHUB_TOKEN=""

# Observability (P10-05) - Sentry error tracking. Inert (no code changes
# needed) if left unset - api/web both boot and run identically without
# it. NEXT_PUBLIC_SENTRY_DSN is usually the same DSN as SENTRY_DSN, just
# exposed to the browser bundle (Sentry DSNs are meant to be public).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DEBUG=1 logs every Sentry SDK operation to stdout - useful for
# confirming an error was actually captured, noisy otherwise.
SENTRY_DEBUG=""
