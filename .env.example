# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vaettir?schema=public"

# Production only (leave unset for local dev - DATABASE_URL above takes
# priority when set): composes DATABASE_URL at startup from an RDS-managed
# Secrets Manager secret's live username/password instead of a static URL.
# See docs/AWS_DEPLOYMENT.md.
DB_SECRET_ID=""
DB_HOST=""
DB_PORT="5432"
DB_NAME="postgres"
DB_SSLMODE="require"

# AI agent (reverse-engineering + strategy generation)
ANTHROPIC_API_KEY=""

# API
API_PORT=4000

# Auth (Clerk) - api verifies session tokens with the secret key; web/mobile
# use the publishable key to initialize the Clerk client.
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Server-only credential shared with the trusted Studio access-review worker.
# Never expose this value in web or mobile environment variables.
STAFF_ADMIN_TOKEN=""

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Mobile
EXPO_PUBLIC_API_URL="http://localhost:4000"

# GitHub App / PR scanning (phase 2)
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# PagerDuty incident linkage (P9-04) - HMAC secret for verifying the
# X-PagerDuty-Signature header on inbound /webhooks/pagerduty deliveries.
# Inert (route responds 200/handled:false) if left unset. Also needs each
# project's PagerDuty Service ID set via the project page for routing.
PAGERDUTY_WEBHOOK_SECRET=""

# Staff-only admin > Repo Health Snapshot (admin.repoHealthSnapshot) - a
# plain PAT with `repo` + `actions:read` scope, used to read GitHub Actions
# run history for ANY repo pointed at it, not just onboarded customers'.
# Not used anywhere else; leave unset if that tool isn't needed.
STAFF_GITHUB_TOKEN=""

# Observability (P10-05) - Sentry error tracking. Inert (no code changes
# needed) if left unset - api/web both boot and run identically without
# it. NEXT_PUBLIC_SENTRY_DSN is usually the same DSN as SENTRY_DSN, just
# exposed to the browser bundle (Sentry DSNs are meant to be public).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Local runs do NOT report to Sentry even with a DSN set (they were filling
# the production projects with environment=development noise). To report
# from a local run, set SENTRY_DEBUG=1 or SENTRY_ENVIRONMENT=<name>.
# SENTRY_DEBUG=1 logs every Sentry SDK operation to stdout - useful for
# confirming an error was actually captured, noisy otherwise.
SENTRY_DEBUG=""
# Mobile (apps/mobile) - same DSN idea, resolved by app.config.js into
# extra.sentryDsn. Normally set per EAS build profile in apps/mobile/eas.json
# rather than here; a __DEV__ bundle never reports unless
# EXPO_PUBLIC_SENTRY_DEBUG=1 (the mobile counterpart of SENTRY_DEBUG).
EXPO_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_DEBUG=""
