# Docker Official Image via ECR Public avoids shared CodeBuild Docker Hub pull limits.
# Trixie carries Debian fixes unavailable in Bookworm for the release-blocking
# Perl CVEs. Keep the package floor below and rescan each final image digest.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS runtime

ARG VAETTIR_RELEASE_COMMIT
RUN node -e "if(!/^[a-f0-9]{40}$/.test(process.argv[1]))process.exit(1)" "$VAETTIR_RELEASE_COMMIT"

# Prisma's query/schema engine binaries link against OpenSSL, which the
# slim base image doesn't ship -- without it Prisma fails with an opaque
# "Schema engine error: undefined" rather than a clear missing-lib error.
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssl ca-certificates git perl-base libpcre2-8-0 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && git --version \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @vaettir/api exec playwright install --with-deps chromium \
    && pnpm --filter @vaettir/db generate \
    && node scripts/check-prisma-runtime.mjs \
    && pnpm turbo run build --filter=@vaettir/api...

ENV NODE_ENV=production \
    API_PORT=8000 \
    VAETTIR_RELEASE_COMMIT=$VAETTIR_RELEASE_COMMIT
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations run here, on every container start, rather than as a separate
# step -- RDS isn't reachable from outside the VPC, so the running task is
# the only thing that ever has network access to it.
#
# DATABASE_URL is composed first and exported into the shell, then handed
# to both steps below. This is deliberate, not redundant with
# resolveDatabaseUrl.ts's own in-process logic: that logic runs inside
# server.js's own Node process, which starts *after* `prisma migrate
# deploy` here already needs a working DATABASE_URL - composing it only in
# server.js left the migration step with none at all once the static
# vaettir/database-url secret was retired (a real bug caught in production
# on the first deploy attempt of the RDS-managed-secret fix, P1012 instead
# of the P1000 this was meant to fix). See resolveDatabaseUrl.ts and
# printDatabaseUrl.ts.
CMD ["sh", "-c", "export DATABASE_URL=$(node apps/api/dist/printDatabaseUrl.js) && pnpm --filter @vaettir/db exec prisma migrate deploy && node apps/api/dist/server.js"]
