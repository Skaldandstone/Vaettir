# Docker Official Image via ECR Public avoids shared CodeBuild Docker Hub pull limits.
# Trixie carries Debian fixes unavailable in Bookworm for the release-blocking
# Perl CVEs. Keep the package floor below and rescan each final image digest.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS vendor-build
# Build the maintained Debian Expat source (including CVE-2026-102633's
# patch) against Trixie. No unstable binary packages or compiler reach runtime.
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 build-essential debhelper po-debconf docbook-to-man docbook2x autoconf automake libtool pkg-config gpgv debian-keyring \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/fetch-runtime-vendor-sources.mjs scripts/runtime-vendor-sources.json /build/scripts/
COPY scripts/check-expat-wide-runtime.c /build/scripts/
RUN node /build/scripts/fetch-runtime-vendor-sources.mjs /build/runtime-sources \
    && cd /build/runtime-sources \
    && gpgv --keyring /usr/share/keyrings/debian-keyring.gpg expat_2.8.5-2.dsc \
    && dpkg-source -x expat_2.8.5-2.dsc /build/expat \
    && cd /build/expat \
    && timeout 900 env DEB_BUILD_OPTIONS=parallel=2 dpkg-buildpackage -b -us -uc \
    && timeout 600 make -C build check \
    && gcc -std=c11 -Wall -Wextra -Werror -I/build/expat/srcw/lib /build/scripts/check-expat-wide-runtime.c -L/build/expat/buildw/lib/.libs -Wl,-rpath,/build/expat/buildw/lib/.libs -lexpatw -o /build/check-expat-wide \
    && timeout 10 /build/check-expat-wide
COPY scripts/build-dash-runtime.sh scripts/check-dash-runtime.mjs /build/scripts/
RUN node /build/scripts/fetch-runtime-vendor-sources.mjs /build/dash-sources dash \
    && sh /build/scripts/build-dash-runtime.sh /build/dash-sources /build/dash-build /build/scripts/check-dash-runtime.mjs

# Rebuild only the maintained shared LLVM package with its supported optional
# Windows-manifest XML feature off. Keep all LLVM targets/Polly and Mesa, and
# reject SONAME/export/data ABI changes instead of forcing apt dependencies.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS llvm-build-inputs
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 build-essential clang-19 binutils-gold patch xz-utils cmake ninja-build python3 libffi-dev libedit-dev libncurses-dev libz3-dev libpfm4-dev zlib1g-dev libzstd-dev libllvm19 gpgv debian-keyring \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/fetch-runtime-vendor-sources.mjs scripts/runtime-vendor-sources.json scripts/build-llvm-runtime.sh scripts/native-build-concurrency.mjs scripts/native-llvm-checkpoint.mjs scripts/check-llvm-package.mjs scripts/check-llvm-jit.c scripts/check-llvm-arm-defaults.cpp scripts/reconcile-llvm-arm-unit-fixture.mjs /build/scripts/
RUN node /build/scripts/fetch-runtime-vendor-sources.mjs /build/llvm-sources llvm

# Explicit non-runtime diagnostic target. Measure both configurations and dry
# graphs within a short existing build job before deciding compiler phase splits.
FROM llvm-build-inputs AS llvm-configure-only
LABEL vaettir.artifact-purpose="llvm-configure-only" vaettir.runtime-eligible="false"
RUN sh /build/scripts/build-llvm-runtime.sh --configure-only

# Actual release-core/ABI diagnosis cannot feed the runtime package graph.
FROM llvm-build-inputs AS llvm-release-core-only
LABEL vaettir.artifact-purpose="llvm-release-core-only" vaettir.runtime-eligible="false"
RUN sh /build/scripts/build-llvm-runtime.sh --release-core-only

# Default runtime packaging still requires the entire fail-hard dual build.
# It does not inherit the diagnostic target or any diagnostic-only acceptance.
FROM llvm-build-inputs AS llvm-build
RUN sh /build/scripts/build-llvm-runtime.sh

# Explicit builder-only continuation targets. Registry transport, immutable
# digest verification, storage and transfer budgets must be accepted separately.
# None of these optional targets is a donor for the default runtime graph.
# A continuation inherits only the preceding checkpoint, never a diagnostic.
FROM llvm-build-inputs AS llvm-checkpoint-prepare
LABEL vaettir.artifact-purpose="llvm-builder-checkpoint" vaettir.runtime-eligible="false"
RUN sh /build/scripts/build-llvm-runtime.sh --phase prepare

FROM llvm-checkpoint-prepare AS llvm-checkpoint-release-core
RUN sh /build/scripts/build-llvm-runtime.sh --phase release-core --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash prepare)"

FROM llvm-checkpoint-release-core AS llvm-checkpoint-release-units
RUN sh /build/scripts/build-llvm-runtime.sh --phase release-units --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash release-core)"

FROM llvm-checkpoint-release-units AS llvm-checkpoint-assertion-compile-1
RUN sh /build/scripts/build-llvm-runtime.sh --phase assertion-compile-1 --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash release-units)"

FROM llvm-checkpoint-assertion-compile-1 AS llvm-checkpoint-assertion-compile-2
RUN sh /build/scripts/build-llvm-runtime.sh --phase assertion-compile-2 --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash assertion-compile-1)"

FROM llvm-checkpoint-assertion-compile-2 AS llvm-checkpoint-assertion-compile-3
RUN sh /build/scripts/build-llvm-runtime.sh --phase assertion-compile-3 --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash assertion-compile-2)"

FROM llvm-checkpoint-assertion-compile-3 AS llvm-checkpoint-final
RUN sh /build/scripts/build-llvm-runtime.sh --phase final --predecessor-sha256 "$(node /build/scripts/native-llvm-checkpoint.mjs hash assertion-compile-3)"

# Build the maintained native zlib package with the pinned upstream recovery
# patch. Signed source, original ABI and fail-hard checks gate the artifact.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS zlib-build
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 build-essential binutils patch debhelper autoconf automake libtool gpgv debian-keyring \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/fetch-runtime-vendor-sources.mjs scripts/runtime-vendor-sources.json scripts/build-zlib-runtime.sh scripts/check-zlib-runtime.mjs scripts/zlib-runtime-regression.c /build/scripts/
RUN node /build/scripts/fetch-runtime-vendor-sources.mjs /build/zlib-sources zlib \
    && sh /build/scripts/build-zlib-runtime.sh /build/zlib-sources /build/zlib-build /build/scripts/check-zlib-runtime.mjs /build/scripts/zlib-runtime-regression.c

# Signed maintained Git/curl source, narrowly configured HTTP(S) with OpenSSL.
# Git's static transport avoids admitting GnuTLS/Kerberos/LDAP/RTMP to runtime.
# Existing certificate verification and all native checks remain mandatory.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS git-openssl-build
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 build-essential pkg-config autoconf automake libtool binutils dpkg-dev gpgv debian-keyring libssl-dev libnghttp2-dev libexpat1-dev libpcre2-dev zlib1g-dev perl python3 liberror-perl \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/fetch-git-openssl-sources.mjs scripts/git-openssl-sources.json scripts/build-git-openssl-runtime.sh scripts/check-git-openssl-runtime.mjs /build/scripts/
RUN node /build/scripts/fetch-git-openssl-sources.mjs /build/git-curl-sources/git git \
    && node /build/scripts/fetch-git-openssl-sources.mjs /build/git-curl-sources/curl curl \
    && sh /build/scripts/build-git-openssl-runtime.sh /build/git-curl-sources /build/git-openssl-build /build/scripts/check-git-openssl-runtime.mjs

FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS runtime

ARG VAETTIR_RELEASE_COMMIT
RUN node -e "if(!/^[a-f0-9]{40}$/.test(process.argv[1]))process.exit(1)" "$VAETTIR_RELEASE_COMMIT"

# Prisma's query/schema engine binaries link against OpenSSL, which the
# slim base image doesn't ship -- without it Prisma fails with an opaque
# "Schema engine error: undefined" rather than a clear missing-lib error.
# Bootstrap trust from the base's signed Debian repository before enabling
# HTTPS backports. Do not ignore a failed repository update or bypass TLS.
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/debian-backports.sources /etc/apt/sources.list.d/vaettir-backports.sources
COPY --from=vendor-build /build/libexpat1_2.8.5-2_*.deb /tmp/vaettir-vendor/
COPY --from=git-openssl-build /build/git-openssl-build/vaettir-git-openssl_2.47.3-0+deb13u1+vaettir1_amd64.deb /tmp/vaettir-vendor/
COPY --from=vendor-build /build/dash-build/dash_0.5.12-12+vaettir1_amd64.deb /tmp/vaettir-vendor/
COPY --from=vendor-build /build/dash-build/dash-source-signature.status /usr/share/vaettir/dash-source-signature.status
COPY --from=vendor-build /build/dash-build/dash-runtime-proof.txt /usr/share/vaettir/dash-builder-runtime-proof.txt
COPY --from=vendor-build /build/dash-sources/source-manifest.json /usr/share/vaettir/dash-source-manifest.json
COPY --from=llvm-build /build/libllvm19_19.1.7-3+vaettir1_amd64.deb /tmp/vaettir-vendor/
COPY --from=llvm-build /build/llvm-cpu-jit /usr/share/vaettir/llvm-cpu-jit
COPY --from=zlib-build /build/zlib-build/zlib1g_1.3.dfsg+really1.3.2-3+vaettir1_amd64.deb /tmp/vaettir-vendor/
COPY --from=zlib-build /build/zlib-build/zlib-source-signature.status /usr/share/vaettir/zlib-source-signature.status
COPY --from=zlib-build /build/zlib-build/zlib-runtime-proof.json /usr/share/vaettir/zlib-runtime-proof.json
COPY --from=zlib-build /build/zlib-build/zlib-sanitizer-proof.txt /usr/share/vaettir/zlib-sanitizer-proof.txt
COPY --from=zlib-build /build/zlib-build/zlib-runtime-regression /usr/share/vaettir/zlib-runtime-regression
COPY --from=zlib-build /build/zlib-sources/source-manifest.json /usr/share/vaettir/zlib-source-manifest.json
COPY --from=vendor-build /build/runtime-sources/source-manifest.json /usr/share/vaettir/runtime-source-manifest.json
# Validate dpkg-query semantic absence for libxml2, including not-installed stubs.
COPY scripts/check-runtime-package-absence.mjs /usr/local/lib/vaettir/check-runtime-package-absence.mjs
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 /tmp/vaettir-vendor/*.deb \
    && apt-get install -y --no-install-recommends libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 libfontconfig1 libfreetype6 fonts-liberation fonts-noto-color-emoji fonts-dejavu-core \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && test "$(dpkg-query -W -f='${Version}' vaettir-git-openssl)" = '1:2.47.3-0+deb13u1+vaettir1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libexpat1)" ge '2.8.5-2' \
    && test "$(dpkg-query -W -f='${Version}' libllvm19)" = '1:19.1.7-3+vaettir1' \
    && test "$(dpkg-query -W -f='${Version}' dash)" = '0.5.12-12+vaettir1' \
    && test "$(dpkg-query -W -f='${Version}' zlib1g)" = '1:1.3.dfsg+really1.3.2-3+vaettir1' \
    && node /usr/local/lib/vaettir/check-runtime-package-absence.mjs --image-build \
    && git --version \
    && rm /tmp/vaettir-vendor/libexpat1_2.8.5-2_*.deb \
    && rm /tmp/vaettir-vendor/vaettir-git-openssl_2.47.3-0+deb13u1+vaettir1_amd64.deb \
    && rm /tmp/vaettir-vendor/libllvm19_19.1.7-3+vaettir1_amd64.deb \
    && rm /tmp/vaettir-vendor/dash_0.5.12-12+vaettir1_amd64.deb \
    && rm /tmp/vaettir-vendor/zlib1g_1.3.dfsg+really1.3.2-3+vaettir1_amd64.deb \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile \
    && pnpm --filter @vaettir/api exec playwright install --only-shell chromium \
    && pnpm --filter @vaettir/db generate \
    && node scripts/check-prisma-runtime.mjs \
    && pnpm turbo run build --filter=@vaettir/api...

# Verify the shipped browser against a synthetic in-memory fixture, with
# networking disabled at the container layer as well as the browser context.
RUN --network=none --mount=type=bind,source=scripts,target=/run/vaettir-image-build,readonly node scripts/prune-runtime-package-manager.mjs --image-build
RUN --network=none timeout 10 /usr/share/vaettir/llvm-arm-policy > /tmp/vaettir-llvm-arm-policy.txt \
    && cmp /usr/share/vaettir/llvm-arm-policy-baseline.txt /tmp/vaettir-llvm-arm-policy.txt \
    && rm /tmp/vaettir-llvm-arm-policy.txt
RUN --network=none node scripts/check-browser-runtime.mjs
RUN --network=none node scripts/check-browser-graphics.mjs
RUN --network=none node scripts/check-git-runtime.mjs
RUN --network=none node scripts/check-git-openssl-runtime.mjs --installed
RUN --network=none node scripts/check-dash-runtime.mjs
RUN --network=none node scripts/check-zlib-runtime.mjs --installed /usr/lib/x86_64-linux-gnu/libz.so.1 /usr/share/vaettir/zlib-runtime-proof.json /usr/share/vaettir/zlib-runtime-regression
RUN --network=none node scripts/check-image-runtime.mjs
RUN --network=none node scripts/check-mesa-runtime.mjs

ENV NODE_ENV=production \
    API_PORT=8000 \
    VAETTIR_RELEASE_COMMIT=$VAETTIR_RELEASE_COMMIT
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

# Migrations run here, on every container start, rather than as a separate
# step -- RDS isn't reachable from outside the VPC, so the running task is
# the only thing that ever has network access to it.
#
# DATABASE_URL is composed first and exported into the shell, then handed
# to both steps below. This is deliberate, not redundant with
# resolveDatabaseUrl.ts's own in-process logic: that logic runs inside
# server.js's own Node process, which starts *after* `prisma migrate
# deploy` here already needs a working DATABASE_URL - composing it only in
# server.js left the migration step with none at all once the static
# vaettir/database-url secret was retired (a real bug caught in production
# on the first deploy attempt of the RDS-managed-secret fix, P1012 instead
# of the P1000 this was meant to fix). See resolveDatabaseUrl.ts and
# printDatabaseUrl.ts.
CMD ["sh", "-c", "export DATABASE_URL=$(node apps/api/dist/printDatabaseUrl.js) && pnpm --filter @vaettir/db exec prisma migrate deploy && node apps/api/dist/server.js"]
