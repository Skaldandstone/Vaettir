# Pinned upstream SQLite, preserving NSS and libsqlite3.so.0 consumers.
FROM public.ecr.aws/docker/library/node:22-trixie-slim@sha256:b26b04c123d9ff8ab646ceb18b9d75a1173acf64b9a401094b906d27b29338d4 AS sqlite-security
RUN test "$(dpkg --print-architecture)" = amd64 \
    && apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends openssl ca-certificates perl-base libpcre2-8-0 build-essential binutils python3 tcl8.6-dev libnss3-tools libsqlite3-0=3.46.1-7+deb13u2 \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' perl-base)" ge '5.40.1-6+deb13u1' \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' libpcre2-8-0)" ge '10.46-1~deb13u3' \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY scripts/sqlite-runtime-sources.json scripts/fetch-sqlite-runtime-sources.mjs scripts/build-sqlite-runtime.sh scripts/check-sqlite-runtime.mjs scripts/sqlite-runtime-regression.c /build/scripts/
RUN node /build/scripts/fetch-sqlite-runtime-sources.mjs /build/sqlite-inputs
ARG VAETTIR_RELEASE_COMMIT
ENV VAETTIR_SQLITE_SOURCE_COMMIT=$VAETTIR_RELEASE_COMMIT
RUN --network=none sh /build/scripts/build-sqlite-runtime.sh /build/sqlite-inputs /build/sqlite-native /build/scripts

# Export complete proofs, sources, build logs and both regression controls for
# independent review. This proof target is never a production runtime image.
FROM scratch AS proof
COPY --from=sqlite-security /build/sqlite-native/ /sqlite-native/
COPY --from=sqlite-security /build/sqlite-inputs/ /sqlite-inputs/
COPY --from=sqlite-security /build/scripts/ /scripts/
