{
  "name": "@vaettir/web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.mjs && vitest run",
    "test:typed": "vitest run",
    "test:e2e": "playwright test",
    "test:fixtures": "playwright test --config=e2e/fixture.config.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.7",
    "@sentry/nextjs": "^11.16.0",
    "@tanstack/react-query": "^5.108.3",
    "@trpc/client": "^11.29.7",
    "@trpc/react-query": "^11.28.5",
    "@trpc/server": "^11.29.7",
    "@vaettir/core": "workspace:*",
    "docx": "9.16.0",
    "exceljs": "4.4.0",
    "next": "^16.4.6",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vaettir/api": "workspace:*",
    "@vaettir/db": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
