{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vaettir-domain-edge",
  "account_id": "47983d4dad51f0db6dbab407d1ac708c",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 0 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "404-page" },
  "services": [{ "binding": "STUDIO", "service": "skaldandstone" }],
  "vars": {
    "ENABLED_WORKSPACE_HOSTS": "",
    "VAETTIR_APP_ORIGIN": "https://d35bt2repnvk6t.cloudfront.net"
  },
  "routes": [
    { "pattern": "vaettir.app", "custom_domain": true },
    { "pattern": "www.vaettir.app", "custom_domain": true }
  ]
}
