{
  "name": "vaettir",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vaettir/db generate",
    "db:migrate": "pnpm --filter @vaettir/db migrate",
    "db:studio": "pnpm --filter @vaettir/db studio"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.24",
    "globals": "^17.11.0",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.68.0"
  }
}
