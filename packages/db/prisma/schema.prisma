// Quality Intelligence Platform — core data model.
//
// Design principle: test PLAN TYPES and COMPLIANCE FRAMEWORKS are data, not
// hardcoded enums. New plan shapes (a new compliance form, a new testing
// discipline) are added by inserting rows + a JSON field schema, not by
// shipping a migration. This is the fix for "shoehorning" that most test
// case tools do.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  planTierId String
  planTier   PlanTier @relation(fields: [planTierId], references: [id])

  // How long evidence/audit-log/test-result data is retained before it's
  // eligible for deletion. Defaults to the 5-year baseline; orgs on
  // compliance-heavy plans may configure this higher per P3-08.
  dataRetentionYears Int @default(5)

  // P7-08: whether attempting to move a Release to READY with unmet
  // acceptance criteria or an open CRITICAL risk flag is a HARD_BLOCK
  // (server refuses the status change outright) or just a SOFT_WARNING
  // (the UI surfaces the gap and lets the user proceed anyway). Defaults to
  // the non-breaking option so existing orgs' release workflows don't
  // suddenly start rejecting a status change they were relying on.
  releaseGatePolicy ReleaseGatePolicy @default(SOFT_WARNING)

  // P7-09: readiness digest -- an incoming Slack webhook URL and an
  // enable/hour toggle, kept minimal and org-scoped for this one purpose
  // rather than building Phase 9's general integration-config framework
  // (P9-00, queued, not started) early. digestHourUtc is a plain 0-23 UTC
  // hour, not a per-org timezone -- picking one right now would be a
  // half-built feature (stored but unused) since nothing else in the
  // platform tracks org timezone yet.
  slackWebhookUrl  String?
  digestEnabled    Boolean   @default(false)
  digestHourUtc    Int?
  lastDigestSentAt DateTime?

  // Renames the display labels for TestCaseStep's four fields, e.g.
  // {"expectedActionOrData": "Backend Call"}. Keys are the field names in
  // TestCaseStep; any key not present falls back to
  // @tci/core's DEFAULT_STEP_FIELD_LABELS. Exists because the field names
  // themselves ("expected action or data" etc.) are acknowledged
  // placeholders -- teams should be able to relabel them without a schema
  // change or a migration.
  stepFieldLabels Json?

  projects             Project[]
  memberships          Membership[]
  invitations          Invitation[]
  aiCreditTransactions AiCreditTransaction[]
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  webhookEndpoints     WebhookEndpoint[]
}

// P9-06: outbound webhooks -- lets an external system react to platform
// events (a new risk flag, a review-queue item, a compliance sign-off)
// without polling. Deliberately a flat per-org list rather than P9-00's
// full integration-config framework (routing per project, field mapping) -
// that's real scope for when a specific destination tool needs it; this is
// the generic "give me a URL to POST to" version every specific integration
// can build on later.
model WebhookEndpoint {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  // HMAC signing secret, generated server-side and shown to the creator
  // exactly once -- same "write-only from the client" reasoning as
  // Organization.slackWebhookUrl, just inverted (here WE hold the secret
  // and the receiver verifies us, rather than us holding theirs).
  secret     String
  eventTypes String[] // subset of WEBHOOK_EVENT_TYPES (services/webhookDelivery.ts) -- empty means subscribed to nothing until explicitly set
  enabled    Boolean  @default(true)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

// Delivery attempt log -- lets an org admin see "is this actually working"
// (last N attempts, status codes, errors) rather than a webhook silently
// failing forever with no visibility, the single biggest complaint about
// outbound-webhook systems in general.
model WebhookDelivery {
  id                String          @id @default(cuid())
  webhookEndpointId String
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)
  eventType         String
  payload           Json
  success           Boolean
  responseStatus    Int?
  error             String?
  createdAt         DateTime @default(now())

  @@index([webhookEndpointId, createdAt])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  slug           String
  repoUrl        String?
  defaultBranch  String       @default("main")
  createdAt      DateTime     @default(now())

  // The commit SHA the most recent successful repo scan resolved `ref` to
  // (P2-05). When set, the next scan diffs from here to HEAD instead of
  // walking and hashing every test file in the repo -- one `git diff` call
  // against just the changed paths, rather than a full-tree read+hash pass.
  // Null until a project has been scanned at least once.
  lastScannedCommitSha String?

  testPlans                 TestPlan[]
  testCases                 TestCase[]
  sharedStepGroups          SharedStepGroup[]
  requirements              Requirement[]
  releases                  Release[]
  testRuns                  TestRun[]
  coverageReports           CoverageReport[]
  reverseEngineerJobs       ReverseEngineerJob[]
  testSelectionRuns         TestSelectionRun[]
  auditLogs                 AuditLog[]
  customFrameworkHeuristics CustomFrameworkHeuristic[]
  prScanPolicy              PrScanPolicy?
  healingSuggestions        HealingSuggestion[]
  complianceEvidence        ComplianceEvidence[]
  complianceSignOffs        ComplianceSignOff[]
  aiEditFeedback            AiEditFeedback[]

  @@unique([organizationId, slug])
}

// ---------------------------------------------------------------------------
// Identity & seat-based billing
// ---------------------------------------------------------------------------

// Identity lives in Clerk; this row is the local mirror everything else in
// the schema (Membership, audit columns, etc.) actually references. Created
// lazily on a new Clerk user's first authenticated request -- see
// apps/api/src/trpc.ts.
model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())

  memberships       Membership[]
  sentInvitations   Invitation[]
  reviewedTestCases TestCase[]   @relation("TestCaseReviewedBy")
  createdWebhookEndpoints WebhookEndpoint[]
  testCaseVersions TestCaseVersion[]
  createdSharedStepGroups SharedStepGroup[]

  // P1-07 audit columns: who created/last-updated each core record. Named
  // relations (Prisma requires it once a model has more than one FK to the
  // same target) -- see each model for the paired createdBy/updatedBy.
  createdTestCases           TestCase[]                 @relation("TestCaseCreatedBy")
  updatedTestCases           TestCase[]                 @relation("TestCaseUpdatedBy")
  createdTestPlans           TestPlan[]                 @relation("TestPlanCreatedBy")
  updatedTestPlans           TestPlan[]                 @relation("TestPlanUpdatedBy")
  testPlanVersions           TestPlanVersion[]
  customFrameworkHeuristics  CustomFrameworkHeuristic[]
  createdReleases            Release[]                  @relation("ReleaseCreatedBy")
  updatedReleases            Release[]                  @relation("ReleaseUpdatedBy")
  createdRiskFlags           RiskFlag[]                 @relation("RiskFlagCreatedBy")
  updatedRiskFlags           RiskFlag[]                 @relation("RiskFlagUpdatedBy")
  reviewedHealingSuggestions HealingSuggestion[]        @relation("HealingSuggestionReviewedBy")
  recordedComplianceEvidence ComplianceEvidence[]
  signedComplianceSignOffs   ComplianceSignOff[]
  aiEditFeedback             AiEditFeedback[]

  // P1-05: a service token is backed by its own real User row (the
  // "service user") so it flows through every existing requireOrgRole /
  // requireProjectAccess / createdById check unmodified -- no separate
  // API-key authz code path to keep in sync with the human one.
  apiKeyIdentity ApiKey?  @relation("ApiKeyServiceUser")
  createdApiKeys ApiKey[] @relation("ApiKeyCreatedBy")

  auditLogs AuditLog[]
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
  COMPLIANCE_AUDITOR
}

// A "seat" in the pricing model. FULL seats consume the plan's full-seat
// allotment and can hold any OrgRole. READ_ONLY seats are cheaper/included
// and are only ever a Membership with role: VIEWER -- enforced in
// packages/core's seat-limit logic, not by a DB constraint, since the
// membership row itself doesn't know the org's current plan.
enum SeatType {
  FULL
  READ_ONLY
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  // Deleting an org takes its memberships with it (they have no meaning
  // without it); a Membership row is never meaningful on its own.
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  // Deliberately NOT cascade: a departing/deleted User's org memberships
  // should be handled explicitly (revoke seat, reassign ownership), not
  // silently vanish, since a Membership is also the audit trail of who had
  // access to what. Restrict (the default) blocks User deletion while
  // memberships exist -- that's correct until P12 builds an explicit
  // "remove member" flow that revokes first.
  user           User         @relation(fields: [userId], references: [id])
  role           OrgRole
  seatType       SeatType     @default(FULL)
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId, seatType])
}

// A pending seat offer. No email is sent by the platform yet (P9 territory)
// -- the inviter is handed a shareable link to send however they like.
// Deliberately NOT tied to Membership until accepted: an invitation is a
// standing offer against a seat that hasn't been consumed, which is exactly
// why seat-limit checks happen both at invite time AND at accept time (the
// org's seat usage can change in between).
model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  // An org's invitations are meaningless without the org -- cascade.
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrgRole
  seatType       SeatType         @default(FULL)
  token          String           @unique @default(cuid())
  invitedById    String
  // Deliberately NOT cascade: don't want the audit trail of "who invited
  // whom" to vanish if the inviter's own account is later deleted.
  invitedBy      User             @relation(fields: [invitedById], references: [id])
  status         InvitationStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?

  @@index([organizationId, status])
  @@index([email])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// A CI-friendly service token (P1-05): "test result ingestion, PR scanning,
// that don't go through a human session." The full key is shown to the
// caller exactly once at creation and never stored -- only its SHA-256
// hash (for lookup) and a short prefix (for the UI to tell keys apart
// without ever displaying the secret again). Auth resolves a presented key
// to `serviceUser` and proceeds through the ordinary Clerk-session code
// path from there, so every authz/audit-column rule applies unchanged.
model ApiKey {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  hashedKey      String       @unique
  role           OrgRole      @default(EDITOR)

  serviceUserId String @unique
  serviceUser   User   @relation("ApiKeyServiceUser", fields: [serviceUserId], references: [id])

  createdByUserId String?
  createdByUser   User?   @relation("ApiKeyCreatedBy", fields: [createdByUserId], references: [id])

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([organizationId])
}

// Plan tiers as data, matching this project's existing "don't hardcode what
// might change" pattern (see TestPlanType/ComplianceFramework). Seeded with
// the tier boundaries as specified; cost fields are left null until pricing
// is finalized -- this table is where that lands, not a code change.
model PlanTier {
  id                       String @id @default(cuid())
  key                      String @unique // "free" | "team" | "business" | "corp"
  name                     String
  sortOrder                Int
  minFullSeats             Int // inclusive lower bound that qualifies for/requires this tier
  maxFullSeats             Int? // inclusive upper bound; null = unlimited (top tier)
  includedReadOnlySeats    Int    @default(0) // read-only seats bundled at this tier
  maxReadOnlySeats         Int? // null = unlimited once on this tier
  monthlyPricePerSeatCents Int? // null = not yet priced

  // AI credits granted to an org on this tier at the start of each calendar
  // month (see AiCreditTransaction) -- covers the real, variable LLM cost
  // of reverse-engineering, PR-scan recommendations, risk assessment, and
  // strategy generation. 0 is a valid, meaningful value (Free tier), not
  // "unset" -- unlike monthlyPricePerSeatCents this always has a value.
  includedAiCreditsPerMonth Int @default(0)

  // P12-07: plumbing only, deliberately empty for now -- a plain list of
  // feature-flag keys enabled at this tier, so a specific tier can gate a
  // specific feature set once those are actually mapped, as data rather
  // than a scattered `if (org.planTier.key === "business")` check wherever
  // that feature lives. No flag currently reads this array; every feature
  // built so far is available on every tier.
  enabledFeatures String[] @default([])

  organizations Organization[]
}

// Append-only ledger, not a mutable balance column -- an org's AI credit
// balance is the sum of its transactions, same reasoning as AuditLog:
// auditable, and a support agent (Phase 13) can see exactly where credits
// went rather than trusting a number that could have drifted from reality.
model AiCreditTransaction {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id])
  type           AiCreditTransactionType
  // Positive for GRANT/TOPUP, negative for CONSUMPTION and a deduction
  // ADJUSTMENT -- signed so balance is always a plain sum, never a
  // type-dependent add-or-subtract branch at read time.
  amount         Int
  // Which AI operation consumed credits (see AI_OPERATION_COSTS in
  // services/aiCredits.ts) -- null for GRANT/TOPUP/ADJUSTMENT rows.
  operation      String?
  description    String?
  createdAt      DateTime                @default(now())

  @@index([organizationId, createdAt])
}

enum AiCreditTransactionType {
  GRANT
  CONSUMPTION
  TOPUP
  ADJUSTMENT
}

// ---------------------------------------------------------------------------
// Pluggable test plan typing
// ---------------------------------------------------------------------------

enum TestPlanCategory {
  FUNCTIONAL // unit, functional, contract, instrumentation, e2e, ...
  QUALITY_STRATEGY // holistic QA strategy plans (per testlio-style structured strategy)
  COMPLIANCE // governance / compliance acceptance plans (SOC2, HIPAA, PCI-DSS, ...)
  RELEASE_READINESS // release acceptance criteria plans
  CUSTOM
}

// One row per plan "shape" an org can author against. `fieldSchema` is a
// JSON Schema document describing the custom fields a TestPlan of this type
// carries in `TestPlan.customFields`. This is how new compliance forms or
// bespoke internal QA templates get added without a code change.
model TestPlanType {
  id          String           @id @default(cuid())
  key         String           @unique // e.g. "unit", "contract", "soc2-cc", "release-readiness"
  name        String
  category    TestPlanCategory
  description String?
  fieldSchema Json // JSON Schema for TestPlan.customFields
  isBuiltIn   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  testPlans TestPlan[]
  testCases TestCase[]
}

model TestPlan {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id])
  testPlanTypeId String
  testPlanType   TestPlanType @relation(fields: [testPlanTypeId], references: [id])
  releaseId      String?
  release        Release?     @relation(fields: [releaseId], references: [id])

  name         String
  description  String?
  status       TestPlanStatus @default(DRAFT)
  customFields Json           @default("{}") // validated against testPlanType.fieldSchema

  // P4-04: lets a QUALITY_STRATEGY-category plan act as a real coordination
  // hub instead of just a document -- a concrete plan (e.g. "regression
  // plan for payments") can point back at the strategy it exists to
  // support. Self-relation rather than a separate join table since it's a
  // simple one-parent-strategy-per-plan link, not a many-to-many.
  strategyId  String?
  strategy    TestPlan?  @relation("StrategyLink", fields: [strategyId], references: [id])
  linkedPlans TestPlan[] @relation("StrategyLink")

  acceptanceCriteria AcceptanceCriterion[]
  testCases          TestCase[]
  versions           TestPlanVersion[]

  createdById String?
  createdBy   User?   @relation("TestPlanCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("TestPlanUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// P4-05: a full snapshot taken on every create/update, not just the
// AuditLog's one-line summary (P3-06) -- a strategy evolving release to
// release needs to see what the risk areas/entry criteria actually said at
// a past point, not just that an update happened. versionNumber is
// per-plan and sequential (1 at creation, incrementing on every update).
model TestPlanVersion {
  id            String         @id @default(cuid())
  testPlanId    String
  testPlan      TestPlan       @relation(fields: [testPlanId], references: [id])
  versionNumber Int
  name          String
  description   String?
  status        TestPlanStatus
  customFields  Json
  createdById   String?
  createdBy     User?          @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@unique([testPlanId, versionNumber])
  @@index([testPlanId, versionNumber])
}

enum TestPlanStatus {
  DRAFT
  ACTIVE
  IN_REVIEW
  APPROVED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Requirements & acceptance criteria
// ---------------------------------------------------------------------------

model Requirement {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String
  description String?
  externalRef String? // e.g. Jira key, Linear issue id, doc URL
  createdAt   DateTime @default(now())

  acceptanceCriteria AcceptanceCriterion[]
}

model AcceptanceCriterion {
  id            String                    @id @default(cuid())
  testPlanId    String
  testPlan      TestPlan                  @relation(fields: [testPlanId], references: [id])
  requirementId String?
  requirement   Requirement?              @relation(fields: [requirementId], references: [id])
  description   String
  status        AcceptanceCriterionStatus @default(PENDING)
  createdAt     DateTime                  @default(now())
}

enum AcceptanceCriterionStatus {
  PENDING
  MET
  NOT_MET
  AT_RISK
}

// ---------------------------------------------------------------------------
// Test cases (BDD-normalized) + provenance back to automated test code
// ---------------------------------------------------------------------------

enum TestCaseType {
  UNIT
  FUNCTIONAL
  CONTRACT
  INSTRUMENTATION
  SMOKE
  SANITY
  REGRESSION
  E2E
  PERFORMANCE
  SECURITY
  ACCESSIBILITY
  EXPLORATORY
  COMPLIANCE
  OTHER
}

enum AutomationStatus {
  MANUAL
  AUTOMATED
  PARTIALLY_AUTOMATED
  NEEDS_AUTOMATION
}

// The canonical, human-readable test case. Whether it was authored by a
// human or reverse-engineered from code by the AI agent, it lives here in
// the same BDD-normalized shape.
model TestCase {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id])
  testPlanId     String?
  testPlan       TestPlan?     @relation(fields: [testPlanId], references: [id])
  testPlanTypeId String?
  testPlanType   TestPlanType? @relation(fields: [testPlanTypeId], references: [id])

  title            String
  background       String? // BDD "Background:" (shared Given context), optional
  given            String[] // Given steps
  when             String[] // When steps
  then             String[] // Then steps
  tags             String[]
  priority         TestCasePriority @default(MEDIUM)
  testType         TestCaseType
  automationStatus AutomationStatus @default(MANUAL)

  // Manual suite/folder assignment, independent of origin -- a "/"-delimited
  // path like the tree UI's derived-from-source grouping (e.g.
  // "auth/password-reset"), but settable on ANY case, not just ones with a
  // source file. When set, this wins over the source-file-derived location
  // for tree placement -- see components/TestCaseTree.tsx. Nullable: an
  // unassigned case (common right after manual authoring) still needs
  // somewhere to render, so it falls into a distinct "Unassigned" bucket
  // rather than being forced into a guessed suite.
  suitePath String?

  // Soft-hide, not soft-delete: an archived case stays fully intact (still
  // linked from past TestSelectionRecommendations, compliance controls,
  // etc.) but drops out of the default list/tree view. Distinct from
  // `delete`, which is a real removal blocked by those same FK links.
  archived Boolean @default(false)

  origin     TestCaseOrigin @default(AUTHORED) // AUTHORED vs AI_REVERSE_ENGINEERED
  confidence Float? // set when origin = AI_REVERSE_ENGINEERED; agent's self-rated confidence 0-1

  // Frozen snapshot of exactly what the AI produced (title/background/
  // given/when/then/tags), written once whenever AI-generated content lands
  // here -- at first creation, and again on P2-04's update-in-place when the
  // source file changed enough to re-run the agent. NEVER touched by a
  // human edit (testCases.update leaves it alone), so it stays a stable
  // "what the AI actually said" baseline to diff the live, possibly-edited
  // content against (P2-06's review-queue diff view). Null for AUTHORED/
  // IMPORTED cases, which have no AI output to compare against.
  aiSnapshot Json?

  // Human-authored and imported cases are trusted on arrival (APPROVED).
  // AI-reverse-engineered cases start PENDING_REVIEW regardless of
  // confidence -- confidence informs the reviewer's triage order, it doesn't
  // bypass review. Set explicitly by the agent router at creation time; the
  // schema default only covers the AUTHORED/IMPORTED paths.
  reviewStatus TestCaseReviewStatus @default(APPROVED)
  reviewedById String?
  reviewedBy   User?                @relation("TestCaseReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNote   String?

  // How bad it is if a bug in this scenario ships undetected -- distinct
  // from `priority`, which is authoring/backlog intent set by a human up
  // front. riskSeverity/riskScore are the AI-assessed "if this breaks and
  // nobody caught it, how much does it hurt" signal, read from the actual
  // BDD content + testType + what area of the app it covers. Reuses
  // RiskSeverity (already used by RiskFlag) rather than inventing a
  // parallel enum for the same four-point scale. Nullable until assessed --
  // most test cases won't have this until someone runs assessTestCaseRisk.
  riskSeverity   RiskSeverity?
  riskScore      Int? // 0-100, combines severity + likelihood-of-regression
  riskRationale  String?
  riskAssessedAt DateTime?

  // P5-05: recomputed after every ingested TestRun that includes a result
  // for this case (see detectFlaky in testRuns.ts) -- true when its recent
  // results alternate PASS/FAIL on the same branch beyond a threshold.
  // Deliberately NOT sticky: recomputed fresh each time rather than only
  // ever flipped on, so a test that's stabilized clears its own flag
  // instead of carrying a stale warning forever.
  isFlaky         Boolean   @default(false)
  flakyDetectedAt DateTime?

  source                   TestCaseSource?
  complianceControls       TestCaseComplianceControl[]
  results                  TestResult[]
  healingSuggestions       HealingSuggestion[]
  complianceEvidence       ComplianceEvidence[]
  aiEditFeedback           AiEditFeedback[]
  // The structured step-table authoring format -- an alternative (or
  // complement) to given/when/then above. A TestCase can carry either,
  // both, or neither populated; the UI renders whichever has content. See
  // TestCaseStep for why this exists alongside BDD rather than replacing it.
  steps                    TestCaseStep[]
  selectionRecommendations TestSelectionRecommendation[]
  versions                 TestCaseVersion[]

  // 2026-08-27 competitor parity audit: TestRail/qTest/Zephyr/Xray all let
  // a step sequence be authored once and reused across many cases,
  // updated in one place. When set, this case's own structured `steps`
  // (above) are irrelevant - the resolved step list comes from the
  // referenced group instead (see testCases.ts's byId/list). A case
  // either owns its steps or defers to a shared group, never both, same
  // "one or the other" simplicity as given/when/then vs. structured
  // steps already has.
  sharedStepGroupId String?
  sharedStepGroup   SharedStepGroup? @relation(fields: [sharedStepGroupId], references: [id])

  createdById String?
  createdBy   User?   @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("TestCaseUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One "what should we run for this change" analysis -- a diff between two
// refs in a project's repo, mapped against known TestCase source files.
// Persisted (not just computed and returned) so CI can reference a specific
// run's recommendations later, and so there's an audit trail of what was
// actually recommended for a given build, matching the ReverseEngineerJob
// pattern rather than being fire-and-forget.
model TestSelectionRun {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  baseRef      String
  headRef      String
  changedFiles String[]
  createdAt    DateTime @default(now())

  recommendations TestSelectionRecommendation[]
}

// One test case's inclusion/exclusion verdict within a TestSelectionRun.
// `recommended=true` rows are the ones whose known source file was touched
// by the diff (always run -- this isn't optional risk-based sampling, the
// code under test literally changed); `recommended=false` rows are tracked
// too so a UI can show "considered but not required" rather than only ever
// showing the must-run list.
model TestSelectionRecommendation {
  id                 String           @id @default(cuid())
  testSelectionRunId String
  testSelectionRun   TestSelectionRun @relation(fields: [testSelectionRunId], references: [id], onDelete: Cascade)
  testCaseId         String
  testCase           TestCase         @relation(fields: [testCaseId], references: [id])
  recommended        Boolean
  matchReason        String
  // Snapshot of the test case's risk score at the time of this run, not a
  // live join -- so a past run's rationale stays interpretable even after
  // the test case is reassessed later.
  riskScoreSnapshot  Int?

  @@index([testSelectionRunId])
}

// A more granular, technical alternative to a single BDD "When"/"Then" pair
// -- separates what the tester DOES from three independently-useful
// observations: what happens beneath the UI (a request fires, with what
// payload), what the *user* sees, and what the *system* actually returned.
// Teams testing both a UI and the API/service behind it want these three
// tracked separately instead of collapsed into one "expected result" line.
//
// Field names are intentionally plain and their DISPLAY labels are
// deliberately not hardcoded anywhere in the app -- see
// Organization.stepFieldLabels. Only `action` is required; the other three
// are independently optional; e.g. a pure-UI step might only need
// expectedResult.
model TestCaseStep {
  id         String   @id @default(cuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  order      Int

  action               String // the trigger/action, e.g. "When the login button is pushed"
  expectedActionOrData String? // what should happen internally: an API call fires, with what data/payload
  expectedResult       String? // the user-observable outcome, e.g. "The new page loads"
  expectedResponse     String? // the technical/API response, e.g. "200 with { token, userId }"

  @@unique([testCaseId, order])
  @@index([testCaseId])
}

// P5-16-adjacent (2026-08-27 competitor parity audit): every competitor
// researched versions the individual test case, not just the plan it
// belongs to (P4-05's TestPlanVersion). A full snapshot, same reasoning
// as TestPlanVersion - a one-line AuditLog summary answers "an edit
// happened," not "what did the steps actually say two versions ago."
// `steps` is a JSON snapshot (not a live relation) since the structured
// steps themselves don't carry stable identity across an edit (see the
// comment on testCases.ts's `update` mutation) - a version needs to
// freeze exactly what existed, not point at rows that may since have
// been replaced.
model TestCaseVersion {
  id            String           @id @default(cuid())
  testCaseId    String
  testCase      TestCase         @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  versionNumber Int
  title         String
  background    String?
  given         String[]
  when          String[]
  then          String[]
  steps         Json
  tags          String[]
  priority      TestCasePriority
  testType      TestCaseType
  createdById   String?
  createdBy     User?            @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())

  @@unique([testCaseId, versionNumber])
  @@index([testCaseId, versionNumber])
}

// A named, reusable structured-step sequence, editable in one place and
// referenced by any number of TestCases in the same project (see
// TestCase.sharedStepGroupId). `steps` is a JSON array of the same
// {order, action, expectedActionOrData, expectedResult, expectedResponse}
// shape TestCaseStep uses - a real relation table isn't needed here since
// nothing ever queries into an individual shared step on its own.
model SharedStepGroup {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  steps       Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  testCases TestCase[]

  @@index([projectId])
}

enum TestCasePriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestCaseOrigin {
  AUTHORED
  AI_REVERSE_ENGINEERED
  IMPORTED
}

enum TestCaseReviewStatus {
  APPROVED
  PENDING_REVIEW
  REJECTED
}

// Links a TestCase back to the automated test that implements it, so the
// platform can blend coverage/results from real test frameworks with the
// human-readable BDD layer.
model TestCaseSource {
  id                  String          @id @default(cuid())
  testCaseId          String          @unique
  testCase            TestCase        @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  repoUrl             String?
  filePath            String
  functionName        String?
  framework           String // "jest" | "pytest" | "junit5" | "cypress" | "playwright" | "postman" | "custom:<name>" ...
  frameworkFamily     FrameworkFamily @default(CUSTOM)
  lastSyncedCommitSha String?
  lastSyncedAt        DateTime?

  // SHA-256 of the whole source file's raw content as of the last time this
  // case was generated/refreshed from it (P2-04). A re-scan compares this
  // against the file's current hash before re-running the LLM at all: an
  // unchanged file is skipped outright (not just "already tracked, skip
  // forever" -- the old behavior, which meant a changed file never got
  // caught either), and a changed file's persist step updates this row's
  // TestCase in place by (filePath, functionName) instead of creating a
  // duplicate.
  contentHash String?

  // The raw id the test framework/CI reports for this test (e.g.
  // "CartTest::test_empty_checkout_throws"). Once set, incoming TestResults
  // match to this TestCase by exact id instead of fuzzy file/function
  // matching -- this is what P5-04/P5-14's CI listener key off of.
  externalTestId String? @unique

  @@index([framework])
}

// Known frameworks get first-class evaluators; anything else falls back to
// the custom-framework evaluation path (heuristic + AI-assisted parsing).
enum FrameworkFamily {
  JEST
  VITEST
  MOCHA
  PYTEST
  JUNIT
  TESTNG
  RSPEC
  GO_TEST
  CYPRESS
  PLAYWRIGHT
  SELENIUM
  APPIUM
  POSTMAN
  PACT
  ROBOT_FRAMEWORK
  CUSTOM
}

// P5-12: "teach the platform your framework" -- a per-project, per-
// framework structural pattern inferred once from a few example files
// (how are test names decided? assertions? setup/teardown?) and reused as
// context on every later reverse-engineer call for that framework, instead
// of the agent inferring the same pattern from scratch on every file. Only
// meaningful for frameworks with no native evaluator (P5-07/08/09/10) --
// a known framework already gets deterministic structure extraction, which
// is strictly better than a learned-from-examples description.
model CustomFrameworkHeuristic {
  id          String  @id @default(cuid())
  projectId   String
  project     Project @relation(fields: [projectId], references: [id])
  name        String // e.g. "Our internal e2e framework"
  description String // the inferred pattern, in prose -- fed back to the agent as context on later files

  exampleFilePaths String[] // labels of the files the pattern was learned from, for reference/audit only

  // P5-13: confidence the inferred pattern actually generalizes (the
  // agent's own self-rating at inference time, 0-1) and how many times
  // it's actually been used since -- together, the signal for "graduate
  // this into a real native evaluator" the UI prompts on past a threshold,
  // rather than a heuristic nobody's actually leaned on yet.
  confidence Float?
  usageCount Int    @default(0)

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// A unit of work for the AI agent: "read this source and produce BDD test
// cases." Tracks status so long repo scans can run async.
model ReverseEngineerJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])

  inputType ReverseEngineerInputType
  inputRef  String // file path, repo+glob, or opaque paste id
  // Raw source for PASTE/FILE_UPLOAD jobs -- the worker needs the actual
  // content to reverse-engineer, not just inputRef's path/label. REPO_SCAN
  // and CI_UNMATCHED_RESULT jobs source content differently (repo clone,
  // existing TestResult) once those pipelines exist, so this stays nullable.
  content   String?
  framework String?
  status    JobStatus                @default(PENDING)
  error     String?

  // Set when inputType = CI_UNMATCHED_RESULT: the specific TestResult that
  // triggered this job by arriving with no matching TestCaseSource. Lets the
  // pipeline auto-link the produced TestCase's TestCaseSource.externalTestId
  // back to it once the job succeeds, so the *next* run of that same test
  // matches immediately instead of re-flagging.
  triggeringResultId String?     @unique
  triggeringResult   TestResult? @relation(fields: [triggeringResultId], references: [id])

  resultTestCaseIds String[] // TestCase ids produced by this job

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
}

enum ReverseEngineerInputType {
  PASTE
  FILE_UPLOAD
  REPO_SCAN
  // Auto-triggered: a CI test result came in with no matching TestCaseSource.
  CI_UNMATCHED_RESULT
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// Compliance & governance
// ---------------------------------------------------------------------------

model ComplianceFramework {
  id          String  @id @default(cuid())
  key         String  @unique // "soc2", "hipaa", "pci-dss", "gdpr", "iso27001", "fda-21-cfr-part-11", custom keys allowed
  name        String
  version     String?
  description String?
  isBuiltIn   Boolean @default(false)

  controls ComplianceControl[]
}

model ComplianceControl {
  id          String              @id @default(cuid())
  frameworkId String
  framework   ComplianceFramework @relation(fields: [frameworkId], references: [id])
  code        String // e.g. "CC6.1"
  title       String
  description String?

  testCases TestCaseComplianceControl[]
  evidence  ComplianceEvidence[]
  signOffs  ComplianceSignOff[]

  @@unique([frameworkId, code])
}

// P3-05: "this test case is designed to verify this control" (the
// TestCaseComplianceControl mapping above) is a structural claim. This is
// the auditor-facing one: "this SPECIFIC execution actually passed, on
// this date, as proof this control was operating." No update/delete
// mutation exists anywhere in the API for this model on purpose --
// immutable means immutable, not "immutable until someone needs to fix a
// typo." A wrong record gets superseded by a new one, never edited.
model ComplianceEvidence {
  id           String            @id @default(cuid())
  controlId    String
  control      ComplianceControl @relation(fields: [controlId], references: [id])
  testCaseId   String
  testCase     TestCase          @relation(fields: [testCaseId], references: [id])
  // Optional: a specific passing TestResult as the concrete proof (not
  // just "this test case generally covers it") -- nullable because
  // evidence can also be a manual attestation with no automated result
  // behind it (e.g. a documented manual review).
  testResultId String?
  testResult   TestResult?       @relation(fields: [testResultId], references: [id])
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  note         String?

  recordedAt   DateTime @default(now())
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])

  @@index([controlId, recordedAt])
  @@index([projectId, recordedAt])
}

// P3-07: a ComplianceAuditor's formal, durable attestation that a control
// was reviewed and is operating effectively for a given period/release --
// distinct from evidence existing at all. Also immutable by design (no
// update/delete mutation) -- a sign-off is a point-in-time legal-adjacent
// record, not a status field to toggle.
model ComplianceSignOff {
  id        String            @id @default(cuid())
  controlId String
  control   ComplianceControl @relation(fields: [controlId], references: [id])
  projectId String
  project   Project           @relation(fields: [projectId], references: [id])
  // Free text, not an enum -- an org's audit cadence might be "2026-Q3",
  // a release name, or a fiscal period; there's no single universal shape.
  period    String
  statement String

  signedById String
  signedBy   User     @relation(fields: [signedById], references: [id])
  signedAt   DateTime @default(now())

  @@index([controlId, period])
  @@index([projectId, signedAt])
}

model TestCaseComplianceControl {
  testCaseId String
  testCase   TestCase          @relation(fields: [testCaseId], references: [id])
  controlId  String
  control    ComplianceControl @relation(fields: [controlId], references: [id])

  @@id([testCaseId, controlId])
}

// P3-06: who changed what test case/plan/control mapping, when. Most
// compliance frameworks' own controls require this (change management),
// so it's compliance infrastructure even though it isn't scoped to one
// framework. Deliberately append-only from the API surface -- no update
// or delete mutation is exposed, since an editable audit log defeats its
// own purpose. Scoped for now to the mutations an auditor actually asks
// about (test case CRUD + review decisions, test plan CRUD, compliance
// framework/control/mapping changes) rather than every mutation in the
// app -- can widen later if a real audit needs more.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id])
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  entityType     String // "TestCase" | "TestPlan" | "ComplianceFramework" | "ComplianceControl" | "TestCaseComplianceControl"
  entityId       String
  action         AuditAction
  summary        String // human-readable one-liner for the log view, e.g. "Updated test case \"Checkout throws on empty cart\""
  metadata       Json? // optional structured detail, e.g. { before, after } for a field-level diff
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  MAP
  UNMAP
}

// ---------------------------------------------------------------------------
// Execution results (blended across frameworks/CI providers)
// ---------------------------------------------------------------------------

model TestRun {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  ciProvider String // "github-actions" | "circleci" | "jenkins" | ...
  ciRunUrl   String?
  commitSha  String
  branch     String
  startedAt  DateTime
  finishedAt DateTime?
  status     TestRunStatus @default(RUNNING)

  // Manual execution only (ciProvider "manual"): the test cases a tester
  // planned to run in this session, decided at start time. A TestResult
  // only exists once a case is actually recorded - a planned id with no
  // matching TestResult yet is "not run yet", the same semantic every
  // other part of this schema already uses for "never executed" (see
  // P7-02's acceptance-criteria computation). Empty for every CI-ingested
  // run; only meaningful alongside ciProvider = "manual".
  manualTestCaseIds String[] @default([])

  results        TestResult[]
  coverageReport CoverageReport?
}

enum TestRunStatus {
  RUNNING
  PASSED
  FAILED
  PARTIAL
}

// P5-06: coverage data ingestion, separate from pass/fail TestResults --
// feeds the release-readiness coverage-gap logic in Phase 7. `testRunId`
// is optional since a coverage report can be uploaded standalone (a
// separate CI step from whatever posted the JUnit results) but linked to
// the same run when the caller has one, so a run's page can show both.
model CoverageReport {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id])
  testRunId String?      @unique
  testRun   TestRun?     @relation(fields: [testRunId], references: [id])
  commitSha String
  branch    String
  tool      CoverageTool

  linesCovered    Int
  linesTotal      Int
  branchesCovered Int?
  branchesTotal   Int?

  files     CoverageFileEntry[]
  createdAt DateTime            @default(now())

  @@index([projectId, createdAt])
}

// Per-file breakdown -- what the release-readiness coverage-gap check
// (Phase 7) actually needs: not just "78% overall" but which specific
// files are under-covered.
model CoverageFileEntry {
  id       String         @id @default(cuid())
  reportId String
  report   CoverageReport @relation(fields: [reportId], references: [id])

  filePath        String
  linesCovered    Int
  linesTotal      Int
  branchesCovered Int?
  branchesTotal   Int?

  @@index([reportId])
  @@index([filePath])
}

enum CoverageTool {
  ISTANBUL
  COBERTURA
  JACOCO
}

model TestResult {
  id               String           @id @default(cuid())
  testRunId        String
  testRun          TestRun          @relation(fields: [testRunId], references: [id])
  testCaseId       String?
  testCase         TestCase?        @relation(fields: [testCaseId], references: [id])
  externalTestId   String? // raw framework test id when not yet mapped to a TestCase
  // File path as reported by the CI result (JUnit XML classname->file mapping,
  // etc). Needed to fetch source when this result is unmatched and gets
  // auto-enqueued for reverse-engineering (P5-14) -- without it we know a
  // test ran but not where to go read it.
  externalFilePath String?
  status           TestResultStatus
  durationMs       Int?
  errorMessage     String?
  // Manual execution: a free-text "what actually happened" note, distinct
  // from errorMessage (which is specifically a captured failure message
  // from automated ingestion) - a tester leaves this on any status, not
  // just FAIL.
  note             String?

  reverseEngineerJob ReverseEngineerJob?
  artifacts          TestResultArtifact[]
  healingSuggestion  HealingSuggestion?
  complianceEvidence ComplianceEvidence[]

  @@index([testRunId])
  @@index([testCaseId])
}

// P2-07: when a human edits an AI-reverse-engineered test case, capture
// the before/after as a labeled example -- the raw material for
// periodically reviewing edit patterns to tighten the system prompt (a
// human review process; this is just the capture mechanism). Only fires
// for origin: AI_REVERSE_ENGINEERED cases whose title/given/when/then
// actually changed -- an edit that only touches priority/tags/suite,
// or an edit to an AUTHORED/IMPORTED case, isn't AI-quality feedback.
model AiEditFeedback {
  id         String   @id @default(cuid())
  testCaseId String
  testCase   TestCase @relation(fields: [testCaseId], references: [id])
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id])

  beforeTitle String
  beforeGiven String[]
  beforeWhen  String[]
  beforeThen  String[]
  afterTitle  String
  afterGiven  String[]
  afterWhen   String[]
  afterThen   String[]

  editedById String
  editedBy   User     @relation(fields: [editedById], references: [id])
  editedAt   DateTime @default(now())

  @@index([projectId, editedAt])
}

// P6.5: suggest-only test self-healing -- classifies a failing TestResult
// as likely-brittle (selector/locator/text drift, structural refactor) vs.
// likely-real (behavior actually changed), and for brittle failures,
// proposes a concrete fix as a diff-style suggestion. NEVER applied to the
// repo automatically -- see ROADMAP.md's Phase 6.5 intro for why unsupervised
// write access to someone's test source is a deliberately different, much
// higher-risk feature than anything else this platform does. One row per
// failing TestResult (only ever created for FAIL, not PASS/SKIP/FLAKY).
model HealingSuggestion {
  id           String     @id @default(cuid())
  testResultId String     @unique
  testResult   TestResult @relation(fields: [testResultId], references: [id])
  testCaseId   String
  testCase     TestCase   @relation(fields: [testCaseId], references: [id])
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id])

  classification          HealingClassification
  classificationRationale String

  // Only populated when classification is BRITTLE and the agent could
  // confidently ground a fix in the actual diff -- a REAL_REGRESSION, or a
  // brittle failure with no confident fix, leaves these null rather than
  // guessing from the error message alone.
  suggestedDiff       String?
  suggestionRationale String?

  status       HealingSuggestionStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?                   @relation("HealingSuggestionReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // P6.5-04: set when this test case's next real result (via normal CI
  // ingestion, not a triggered re-run) comes back PASS -- closes the loop
  // on "did this suggestion actually help" without needing repo access.
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
  @@index([testCaseId])
}

enum HealingClassification {
  BRITTLE
  REAL_REGRESSION
  UNCERTAIN
}

enum HealingSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// Screenshot/video evidence captured while a front-end automated test was
// running. The runner captures on every run but only *uploads* on failure --
// this row only ever exists for a failing TestResult, by design. Headless
// runs without a display surface simply produce none; that's expected, not
// an error state.
model TestResultArtifact {
  id           String                 @id @default(cuid())
  testResultId String
  testResult   TestResult             @relation(fields: [testResultId], references: [id])
  type         TestResultArtifactType
  storageUrl   String
  capturedAt   DateTime               @default(now())
  durationMs   Int? // set for VIDEO; the trailing window captured before failure

  @@index([testResultId])
}

enum TestResultArtifactType {
  SCREENSHOT
  VIDEO
}

enum TestResultStatus {
  PASS
  FAIL
  SKIP
  FLAKY
  // Manual-execution-only: the tester couldn't attempt this case at all
  // (an environment/dependency issue, not a pass or a fail) - the same
  // "Blocked" concept every competitor's manual execution UI has.
  BLOCKED
}

// ---------------------------------------------------------------------------
// Releases & readiness
// ---------------------------------------------------------------------------

model Release {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id])
  name       String
  targetDate DateTime?
  status     ReleaseStatus @default(PLANNING)

  testPlans TestPlan[]
  riskFlags RiskFlag[]

  createdById String?
  createdBy   User?   @relation("ReleaseCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ReleaseUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReleaseStatus {
  PLANNING
  IN_TESTING
  READY
  SHIPPED
  BLOCKED
}

enum ReleaseGatePolicy {
  SOFT_WARNING
  HARD_BLOCK
}

// P6-06: per-project configuration for recommendForChange's coverage-gap
// detection (P6-03) -- which branches a scan should even consider (forward-
// looking: real branch-triggered scanning needs P6-01's webhook, but the
// policy a scan would consult already needs somewhere to live), path-based
// severity weighting (a gap in a payments/auth path is not the same risk
// as one in a docs folder), and whether a scan should post visibly
// (comment mode) or just flag silently. One row per project, created
// lazily -- a project with no row yet gets this router's documented
// defaults, not a required setup step before PR scanning works at all.
model PrScanPolicy {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  triggerBranches String[]          @default(["main"])
  commentMode     PrScanCommentMode @default(COMMENT)

  // [{ pattern: "apps/api/src/payments/**", severity: "CRITICAL" }, ...] --
  // matched in array order, first match wins, so a project can layer a
  // narrow override ahead of a broad catch-all.
  pathSeverityRules Json @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PrScanCommentMode {
  COMMENT
  SILENT_FLAG_ONLY
}

// A detected gap or risk feeding the release-readiness dashboard, e.g. from
// PR scanning finding changed files with no mapped test coverage.
model RiskFlag {
  id              String       @id @default(cuid())
  releaseId       String
  release         Release      @relation(fields: [releaseId], references: [id])
  severity        RiskSeverity
  source          RiskSource
  description     String
  relatedFilePath String?
  relatedPrUrl    String?

  createdById String?
  createdBy   User?   @relation("RiskFlagCreatedBy", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("RiskFlagUpdatedBy", fields: [updatedById], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
}

enum RiskSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum RiskSource {
  PR_SCAN_COVERAGE_GAP
  FAILING_TEST
  FLAKY_TEST
  MANUAL_FLAG
  MISSING_COMPLIANCE_CONTROL
}
