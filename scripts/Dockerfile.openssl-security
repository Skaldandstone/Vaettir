# Isolated vendor-source proof. No application credentials or customer data.
FROM public.ecr.aws/docker/library/node:26-trixie-slim@sha256:e4db4c914bf8ad241bd24804fc25d272d89bad97e68cdc8a1414862790a02c39 AS build
RUN apt-get update --error-on=any \
    && apt-get install -y --no-install-recommends ca-certificates build-essential binutils debhelper dpkg-dev gpgv debian-keyring patch libzstd-dev zlib1g-dev libssl3t64=3.5.9-1~deb13u1 \
    && rm -rf /var/lib/apt/lists/*
COPY scripts/fetch-openssl-runtime-sources.mjs scripts/openssl-runtime-sources.json scripts/build-openssl-runtime.sh /build/scripts/
RUN node /build/scripts/fetch-openssl-runtime-sources.mjs /build/inputs
RUN --network=none sh /build/scripts/build-openssl-runtime.sh /build/inputs /build/native /build/scripts

FROM scratch AS proof
COPY --from=build /build/native/proof /proof/
COPY --from=build /build/native/packages /packages/
